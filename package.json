{
  "name": "@tappass/dsh-governance",
  "version": "0.1.0",
  "description": "The authority layer for agentic AI, as a DeepSeek Harness plugin. Governs every tool call against your business rules via the TapPass /v1/govern policy decision point.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tappass",
    "governance",
    "agent-authority",
    "policy",
    "guardrails",
    "ai-governance"
  ],
  "homepage": "https://tappass.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tappass/dsh-governance.git"
  },
  "license": "MIT",
  "author": "TapPass (Cogniqor BV)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc.0",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  }
}
